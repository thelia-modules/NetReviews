<?xml version="1.0" encoding="UTF-8"?>
<!--
    Routes declared in XML so they register on BOTH Thelia 2 (whose annotation router reads
    XML/docblocks, not PHP #[Route] attributes) and Thelia 3 (which also loads module
    Config/routing.xml). Do NOT also add #[Route] attributes on the controllers, or Thelia 3
    would register these routes twice.
-->
<routes xmlns="http://symfony.com/schema/routing"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/routing http://symfony.com/schema/routing/routing-1.0.xsd">

    <route id="admin_netreviews_config_save" path="/admin/module/netreviews/configuration" methods="post">
        <default key="_controller">NetReviews\Controller\ConfigurationController::saveAction</default>
    </route>

    <route id="netreviews_order_send" path="/admin/module/netreviews/order/{orderId}" methods="post">
        <default key="_controller">NetReviews\Controller\OrderController::sendAction</default>
        <requirement key="orderId">\d+</requirement>
    </route>
</routes>
